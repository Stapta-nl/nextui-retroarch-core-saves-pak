# Collected on the host for every debug bundle (see tests/collect.sh for the format).
# One collector per line: <output file> | <command>. Run from the repository root.
git-sha.txt | git rev-parse HEAD
git-dirty.txt | git status --porcelain
git-describe.txt | git describe --tags --always --dirty
timestamps.txt | echo "started:  ${TEST_STARTED:-unknown}"; echo "finished: ${TEST_FINISHED:-unknown}"
host-uname.txt | uname -srvm
make-vars.txt | for v in ${MAKE_VARS:-}; do echo "$v"; done
test-target.txt | echo "${TEST_TARGET_INFO:-host run (no device)}"
env-overrides.txt | for v in SRC_PAK RELEASE_ZIP PLATFORM OUT_DIR KEEP TMP_ROOT TEST_BASE COLLECT_USER_DATA MENU_TESTS PAD_NAME PAD_DEVICE UI_WAIT KEY_GAP SDCARD_PATH; do eval "if [ -n \"\${$v+x}\" ]; then echo \"$v=\${$v}\"; fi"; done
tool-versions.txt | bash --version | head -n 1; make --version | head -n 1; jq --version; git --version; file --version | head -n 1; shellcheck --version | sed -n 2p; unzip -v | head -n 1; tests/lib/bats-core/bin/bats --version
